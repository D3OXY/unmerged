{
  "name": "unmerged",
  "description": "GitHub, as if it never got acquired. A calmer, faster skin for github.com.",
  "private": true,
  "license": "MIT",
  "version": "0.1.6",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "pnpm build:chrome && pnpm build:firefox",
    "build:chrome": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "release:prepare": "node scripts/release/prepare.ts",
    "bench": "node bench/run.ts",
    "bench:login": "node bench/login.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "node scripts/release/prepare.ts --check && pnpm typecheck && pnpm test && pnpm lint && pnpm build && pnpm --filter site check",
    "site": "pnpm --filter site dev",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@pierre/diffs": "1.5.2",
    "@pierre/theme": "2.0.0",
    "@pierre/theming": "1.0.1",
    "@shikijs/langs": "4.5.0",
    "@tanstack/react-query": "^5.104.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.1",
    "playwright": "1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4",
    "wxt": "^0.21.4"
  }
}
